<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>This app needs access to your music library to play your songs.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>This app uses notifications to let you know when songs change while you're using other apps or screens.</string>
	<key>UIAppFonts</key>
	<array>
		<string>AtkinsonHyperlegibleMono-Regular.otf</string>
		<string>AtkinsonHyperlegibleMono-ExtraBoldItalic.otf</string>
		<string>AtkinsonHyperlegibleMono-Bold.otf</string>
		<string>AtkinsonHyperlegibleMono-RegularItalic.otf</string>
		<string>AtkinsonHyperlegibleMono-BoldItalic.otf</string>
		<string>AtkinsonHyperlegibleNext-Regular.otf</string>
		<string>AtkinsonHyperlegibleNext-BoldItalic.otf</string>
		<string>AtkinsonHyperlegibleNext-Bold.otf</string>
		<string>AtkinsonHyperlegibleNext-RegularItalic.otf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Folder library (FOLDER_LIBRARY_TOGGLE_PLAN): expose amp's Documents
	     in Finder/Files so music folders can be dragged onto the device and
	     then picked as a folder root. In-place so picked subfolders play
	     from where they live rather than being copied. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
